{
  "name": "artivosalesapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "cp .env.development .env && expo start",
    "start:qa": "cp .env.qa .env && expo start",
    "start:prod": "cp .env.production .env && expo start",
    "android": "expo start --android",
    "android:dev": "cp .env.development .env && expo start --android",
    "android:qa": "cp .env.qa .env && expo start --android",
    "android:prod": "cp .env.production .env && expo start --android",
    "ios": "expo start --ios",
    "ios:dev": "cp .env.development .env && expo start --ios",
    "ios:qa": "cp .env.qa .env && expo start --ios",
    "ios:prod": "cp .env.production .env && expo start --ios",
    "build:dev": "cp .env.development .env && expo export",
    "build:qa": "cp .env.qa .env && expo export",
    "build:prod": "cp .env.production .env && expo export",
    "reset-project": "node ./scripts/reset-project.js",
    "web": "expo start --web",
    "lint": "expo lint",
    "generate": "plop generate",
    "generate:atom": "plop atom",
    "generate:molecule": "plop molecule",
    "generate:organism": "plop organism",
    "generate:hook": "plop hook",
    "generate:screen": "plop screen",
    "generate:tab-screen": "plop tab-screen"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
